#!/bin/sh
# Pre-commit hook: flag non-ASCII characters in staged Markdown files.
#
# Enable it once per clone with:
#     git config core.hooksPath .githooks
#
# Bypass for a single commit (not recommended) with `git commit --no-verify`.

# Staged, added/copied/modified *.md files (NUL-safe).
files=$(git diff --cached --name-only --diff-filter=ACM -z -- '*.md' | tr '\0' '\n')
[ -z "$files" ] && exit 0

# Prefer python3, fall back to python.
py=python3
command -v "$py" >/dev/null 2>&1 || py=python

# shellcheck disable=SC2086
echo "$files" | xargs "$py" tools/check_ascii_md.py
status=$?
if [ "$status" -ne 0 ]; then
  echo ""
  echo "Commit blocked: convert the characters above to ASCII (see tools/check_ascii_md.py)."
fi
exit "$status"
